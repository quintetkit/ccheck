{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "env": { "FOO": "1" },
  "permissions": {
    "allow": ["Bash(ls *)", "Read(src/**)", "mcp__memory__search"],
    "deny": ["Read(./.env)"]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "mcp__memory__.*", "hooks": [{ "type": "command", "command": "echo" }] }
    ],
    "Stop": [ { "hooks": [{ "type": "prompt", "prompt": "まとめて" }] } ]
  },
  "someBrandNewKeyFromNextRelease": true
}
